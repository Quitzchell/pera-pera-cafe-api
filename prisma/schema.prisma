// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LEARNER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  displayName      String
  passwordHash     String?
  role             Role          @default(LEARNER)
  status           UserStatus    @default(INVITED)
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime      @default(now())
  lastActiveAt     DateTime?
  tokens           AuthToken[]
  sessions         AuthSession[]
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum VerbClass {
  GODAN
  ICHIDAN
  IRREGULAR
}

enum JlptLevel {
  N5
  N4
  N3
}

enum ConjugationForm {
  POLITE
  POLITE_NEGATIVE
  POLITE_PAST
  NEGATIVE
  PAST_NEGATIVE
  TE
  PAST
  POTENTIAL
  PASSIVE
  CAUSATIVE
  CAUSATIVE_PASSIVE
  VOLITIONAL
  CONDITIONAL_BA
  IMPERATIVE
  PROHIBITIVE
}

model Verb {
  id             String            @id @default(cuid())
  dictionaryForm String
  reading        String
  meaning        String
  verbClass      VerbClass
  jlptLevel      JlptLevel
  isActive       Boolean           @default(true)
  // Forms the rules produce but nobody uses, e.g. 分かる has no potential.
  excludedForms  ConjugationForm[] @default([])
  // Set on compounds such as 勉強する: the base verb is conjugated, the rest is the prefix.
  baseVerbId     String?
  baseVerb       Verb?             @relation("Compound", fields: [baseVerbId], references: [id], onDelete: Restrict)
  compounds      Verb[]            @relation("Compound")
  createdAt      DateTime          @default(now())

  @@unique([dictionaryForm, reading])
}
