// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LEARNER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  displayName      String
  passwordHash     String?
  role             Role           @default(LEARNER)
  status           UserStatus     @default(INVITED)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime       @default(now())
  lastActiveAt     DateTime?
  tokens           AuthToken[]
  sessions         AuthSession[]
  settings         UserSettings?
  rounds           DrillRound[]
  attempts         Attempt[]
  ruleProgress     RuleProgress[]
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum VerbClass {
  GODAN
  ICHIDAN
  IRREGULAR
}

enum JlptLevel {
  N5
  N4
  N3
}

enum ConjugationForm {
  POLITE
  POLITE_NEGATIVE
  POLITE_PAST
  NEGATIVE
  PAST_NEGATIVE
  TE
  PAST
  POTENTIAL
  PASSIVE
  CAUSATIVE
  CAUSATIVE_PASSIVE
  VOLITIONAL
  CONDITIONAL_BA
  IMPERATIVE
  PROHIBITIVE
  POTENTIAL_CONDITIONAL
}

model Verb {
  id             String            @id @default(cuid())
  dictionaryForm String
  reading        String
  meaning        String
  verbClass      VerbClass
  jlptLevel      JlptLevel
  isActive       Boolean           @default(true)
  // Forms the rules produce but nobody uses, e.g. 分かる has no potential.
  excludedForms  ConjugationForm[] @default([])
  // Set on compounds such as 勉強する: the base verb is conjugated, the rest is the prefix.
  baseVerbId     String?
  baseVerb       Verb?             @relation("Compound", fields: [baseVerbId], references: [id], onDelete: Restrict)
  compounds      Verb[]            @relation("Compound")
  drillItems     DrillItem[]
  attempts       Attempt[]
  createdAt      DateTime          @default(now())

  @@unique([dictionaryForm, reading])
}

enum RuleGroup {
  GODAN_U_TSU_RU
  GODAN_MU_BU_NU
  GODAN_KU
  GODAN_GU
  GODAN_SU
  ICHIDAN
  IRREGULAR_SURU
  IRREGULAR_KURU
  EXCEPTION_IKU
  EXCEPTION_ARU
}

enum DrillMode {
  STANDARD
  CONTRAST
  EXAM
}

model UserSettings {
  userId       String            @id
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabledForms ConjugationForm[]
  jlptLevels   JlptLevel[]
  roundSize    Int               @default(20)
  romajiInput  Boolean           @default(false)
  showFurigana Boolean           @default(true)
  // IANA name such as Europe/Amsterdam; decides which day a finished round counts for.
  timeZone     String            @default("UTC")
}

model DrillRound {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       DrillMode
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  items      DrillItem[]

  @@index([userId, finishedAt])
}

model DrillItem {
  id       String          @id @default(cuid())
  roundId  String
  round    DrillRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  verbId   String
  verb     Verb            @relation(fields: [verbId], references: [id], onDelete: Restrict)
  form     ConjugationForm
  position Int
  // Multiple-choice options, EXAM mode only.
  choices  String[]        @default([])
  attempt  Attempt?

  @@unique([roundId, position])
}

// Append-only: RuleProgress is a projection of this log.
model Attempt {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  drillItemId String          @unique
  drillItem   DrillItem       @relation(fields: [drillItemId], references: [id], onDelete: Cascade)
  verbId      String
  verb        Verb            @relation(fields: [verbId], references: [id], onDelete: Restrict)
  form        ConjugationForm
  ruleGroup   RuleGroup
  answer      String
  isCorrect   Boolean
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
}

model RuleProgress {
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  form            ConjugationForm
  ruleGroup       RuleGroup
  box             Int
  dueAt           DateTime
  attemptCount    Int
  correctCount    Int
  lastPracticedAt DateTime

  @@id([userId, form, ruleGroup])
}
