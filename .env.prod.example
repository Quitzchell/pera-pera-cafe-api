POSTGRES_ROOT_PASSWORD=

# App database connection (assembled into DATABASE_URL in docker-compose.prod.yml)
PERA_DB_USER=
PERA_DB_PASSWORD=
PERA_DB_NAME=

# Frontend origin(s), comma-separated. The first one is used in invite and reset links.
FRONTEND_ORIGIN=
# Parent domain shared by frontend and API, e.g. example.com. Empty: cookie is API host only.
COOKIE_DOMAIN=
# Reverse proxies in front of the app, so rate limiting sees client IPs.
TRUST_PROXY=1
