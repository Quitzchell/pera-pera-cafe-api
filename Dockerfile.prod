# --- Stage 1: build ---
FROM node:26-alpine AS builder
WORKDIR /app

# Install deps (with dev for build)
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci

# Generate Prisma client (uses prisma.config.ts)
RUN npx prisma generate

# Copy source + build
COPY tsconfig*.json nest-cli.json ./
COPY src ./src
RUN npm run build

# Prune dev-deps for runtime
RUN npm prune --omit=dev

# --- Stage 2: runtime ---
FROM node:26-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Do not run on root
RUN addgroup -S nest && adduser -S nest -G nest
USER nest

# Copy only what is needed for runtime
COPY --from=builder --chown=nest:nest /app/package*.json ./
COPY --from=builder --chown=nest:nest /app/node_modules ./node_modules
COPY --from=builder --chown=nest:nest /app/dist ./dist
COPY --from=builder --chown=nest:nest /app/generated ./generated
COPY --from=builder --chown=nest:nest /app/prisma ./prisma
COPY --from=builder --chown=nest:nest /app/prisma.config.ts ./

EXPOSE 3000

# 127.0.0.1 rather than localhost, so the probe can't land on ::1 and fail while
# the server is serving fine. /api/health, not /health: setGlobalPrefix('api').
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "dist/src/main.js"]
